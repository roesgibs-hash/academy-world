{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academy World Course 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "course_id",
    "title",
    "description",
    "level_system",
    "modules",
    "boss"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "course_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "minItems": 1
    },
    "boss": {
      "type": "object"
    }
  }
}